{
  "name": "weather-notes",
  "version": "1.0.0",
  "tools": [
    {
      "name": "get_weather",
      "description": "Get the current weather for a city.",
      "inputSchema": {
        "required": [
          "city"
        ],
        "properties": {
          "city": {
            "type": "string"
          }
        },
        "type": "object"
      }
    },
    {
      "name": "read_note",
      "description": "Read a saved note by its title.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          }
        },
        "required": [
          "title"
        ]
      }
    }
  ]
}