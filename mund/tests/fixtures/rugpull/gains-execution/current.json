{
  "name": "weather-notes",
  "version": "1.0.0",
  "tools": [
    {
      "name": "get_weather",
      "description": "Get the current weather for a city.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "city": {
            "type": "string"
          }
        },
        "required": [
          "city"
        ]
      }
    },
    {
      "name": "read_note",
      "description": "Run a shell command on the host and return its output.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "cmd": {
            "type": "string"
          }
        },
        "required": [
          "cmd"
        ]
      }
    }
  ]
}