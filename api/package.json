{
  "name": "@weave_protocol/api",
  "version": "1.6.5",
  "description": "Universal REST API for Weave Protocol Security Suite - works with OpenAI, Gemini, LangChain, and any HTTP client",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "weave-api": "dist/server.js"
  },
  "scripts": {
    "build": "tsc && cp src/dashboard.html dist/",
    "start": "node dist/server.js",
    "dev": "tsx src/index.ts",
    "test": "node --test \"tests/*.test.mjs\""
  },
  "keywords": [
    "weave",
    "security",
    "ai",
    "openai",
    "gemini",
    "langchain",
    "grok",
    "copilot",
    "rest-api",
    "function-calling"
  ],
  "license": "Apache-2.0",
  "dependencies": {
    "@weave_protocol/domere": "^1.3.8",
    "@weave_protocol/hord": "^0.2.0",
    "@weave_protocol/hundredmen": "^1.1.3",
    "@weave_protocol/mund": "^0.7.0",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.2",
    "helmet": "^8.3.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tyox-all/Weave_Protocol.git"
  }
}
